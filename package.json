{
  "name": "linear-cli",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --compile --outfile bin/linear",
    "test": "vitest run",
    "test:watch": "vitest",
    "link": "ln -sf $(pwd)/bin/linear ~/.local/bin/linear",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "effect": "^3.12.7",
    "@effect/cli": "^0.56.6",
    "@effect/platform": "^0.87.0",
    "@effect/platform-bun": "^0.87.0",
    "@linear/sdk": "^29.0.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.65.0",
    "@effect/vitest": "^0.27.0",
    "@types/bun": "latest",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
