{
  "name": "@cvr/linear",
  "version": "0.7.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cevr/linear-cli.git"
  },
  "bin": {
    "linear": "./bin/linear"
  },
  "files": [
    "bin/linear",
    "npm",
    "skills",
    "CHANGELOG.md"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "link": "ln -sf $(pwd)/bin/linear ~/.local/bin/linear",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit",
    "version": "changeset version && bun scripts/version.ts",
    "release": "changeset publish",
    "release:build": "bun scripts/release.ts",
    "prepack": "bun scripts/release.ts --check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "graphql": "^17.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  }
}
