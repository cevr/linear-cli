#!/bin/sh
# Local pilot switch. Never rewrite argv or change the installed owner's link.
bindir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
case ${LINEAR_IMPL-} in
  ts) exec "$bindir/linear-ts" "$@" ;;
  ergo) exec "$bindir/linear-ergo" "$@" ;;
  '') ;;
  *) printf '%s\n' 'LINEAR_IMPL must be ts or ergo' >&2; exit 1 ;;
esac

# L7: one default for all argv. A missing native binary is a build error;
# LINEAR_IMPL=ts is the explicit way back, not an implicit fallback.
exec "$bindir/linear-ergo" "$@"
