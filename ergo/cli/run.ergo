import exec
import flag
import fs
import io
import json
import linearport/credential
import linearport/files
import linearport/linear
import os
import prompt
import strings
import term

let asJson = flag.Bool("json", false, "Print JSON").Repeated()

// Presence is a domain Option. Only this output boundary chooses JSON omission.
type WireStatus { Emoji json.Optional[string], Label json.Optional[string] }
type WireViewer { Id string, Name string, Email string, Admin bool, Status json.Optional[WireStatus] }
type WireTeam { Id string, Key string, Name string, Description json.Optional[string] }

func wireString(s Option[string]) json.Optional[string] {
	match s {
	case None:
		json.Absent
	case Some[string] as p:
		json.Present[string]{Value: p.Value}
	}
}

func wireViewer(v linear.Viewer) WireViewer {
	let status json.Optional[WireStatus] = match v.Status {
	case None:
		json.Absent
	case Some[linear.Status] as s:
		json.Present[WireStatus]{Value: WireStatus{Emoji: wireString(s.Value.Emoji), Label: wireString(s.Value.Label)}}
	}
	WireViewer{Id: v.Id, Name: v.Name, Email: v.Email, Admin: v.Admin, Status: status}
}

func Run(args []string) fails os.Exit needs linear.Tracker | linear.Reader | linear.Workflow | linear.Writer | linear.RawGraphQL | linear.Uploads | linear.Sessions | credential.Credentials | io.Stdout | io.Stderr | term.Terminal | exec.Runner | fs.Files | fs.Writes | go.Foreign {
	run(args) catch {
	case os.Exit as e:
		return e
	case linear.NoIssues as e:
		return os.Exit{Code: 1, Message: e.Message}
	case prompt.NotInteractive:
		return os.Exit{Code: 1, Message: "Invalid input: prompts need a terminal on standard input"}
	case prompt.Cancelled:
		return os.Exit{Code: 1, Message: "Cancelled"}
	case io.ReadFailed as e:
		return os.Exit{Code: 1, Message: "Error: " + e.Reason}
	case files.WriteFailed as e:
		return os.Exit{Code: 1, Message: "File Error: " + e.Message}
	case linear.InvalidInput as e:
		return os.Exit{Code: 1, Message: "Invalid input: " + e.Message}
	case linear.ApiError as e:
		return os.Exit{Code: 1, Message: "Linear API Error: " + e.Message}
	case linear.AuthError as e:
		return os.Exit{Code: 1, Message: "Authentication Error: " + e.Message}
	case credential.NoToken:
		return os.Exit{Code: 1, Message: "Error: No token found. Run 'linear auth' to authenticate."}
	case credential.ConfigError as e:
		return os.Exit{Code: 1, Message: "Config Error: " + e.Message}
	}
}

func run(args []string) fails os.Exit | linear.InvalidInput | files.WriteFailed | linear.ApiError | linear.AuthError | credential.NoToken | credential.ConfigError | linear.NoIssues | prompt.NotInteractive | prompt.Cancelled | io.ReadFailed needs linear.Tracker | linear.Reader | linear.Workflow | linear.Writer | linear.RawGraphQL | linear.Uploads | linear.Sessions | credential.Credentials | io.Stdout | io.Stderr | term.Terminal | exec.Runner | fs.Files | fs.Writes | go.Foreign {
	// std flag has no command that both runs and holds subcommands, so the
	// bare group name is the one argv this CLI reads before the tree.
	if len(args) == 1 && args[0] == "auth" {
		try authenticate()
		return
	}
	let parsed = match try invocation(args) {
	case None:
		return
	case Some[Invocation] as p:
		p.Value
	}
	if parsed.Command == "api graphql" {
		try apiGraphQL(parsed.Values)
		return
	}
	try dispatch(parsed.Command, parsed.Values)
}

// invocation is the parsed command, or None once help or the version is printed.
func invocation(args []string) Option[Invocation] fails os.Exit needs io.Stdout {
	let root = commands()
	let parsed = flag.ParseRoot(root, args) catch {
	case flag.Help as h:
		io.Stdout.Print(h.Text)
		return None
	case flag.Version as version:
		io.Stdout.Println(version.Text)
		return None
	case DuplicateFlag as d:
		io.Stdout.Print(d.Usage)
		return os.Exit{Code: 1, Message: "ERROR\n  Invalid value for flag " + d.Name + ": \"\(d.Count) occurrences\". Expected: at most 1 value"}
	case err:
		io.Stdout.Print(flag.RootUsage(root))
		return os.Exit{Code: 1, Message: "ERROR\n  " + flag.Describe(err)}
	}
	Some[Invocation]{Value: parsed}
}

// dispatch runs every command but api graphql, whose workspace check is the
// one foreign Go call; tests run dispatch over memory providers.
func dispatch(command string, v flag.Values) fails os.Exit | linear.InvalidInput | files.WriteFailed | linear.ApiError | linear.AuthError | credential.NoToken | credential.ConfigError | linear.NoIssues | prompt.NotInteractive | prompt.Cancelled | io.ReadFailed needs linear.Tracker | linear.Reader | linear.Workflow | linear.Writer | linear.Uploads | io.Stdout | io.Stderr | term.Terminal | fs.Files | fs.Writes {
	if command == "file download" {
		try fileDownload(v)
		return
	}
	if command == "issue start" || command == "issue create" || command == "issue comment" {
		try issueWrite(strings.Split(command, " ")[1], v)
		return
	}
	if command == "issue list" || command == "issue view" || command == "issue files" {
		try issueRead(strings.Split(command, " ")[1], v)
		return
	}
	if command != "team list" && command != "project list" && command != "auth whoami" {
		return os.Exit{Code: 1, Message: "Unknown command: " + command}
	}
	if command == "team list" {
		try teams(enabled(asJson, v))
		return
	}
	if command == "project list" {
		try projects(enabled(asJson, v))
		return
	}
	try viewer(enabled(asJson, v))
}

func teams(asJson bool) fails linear.ApiError | linear.AuthError | credential.NoToken | credential.ConfigError needs linear.Tracker | io.Stdout {
	let teams = try linear.Tracker.Teams()
	if asJson {
		let mut encodedTeams = []WireTeam{}
		for t in teams { encodedTeams = encodedTeams.Append(WireTeam{Id: t.Id, Key: t.Key, Name: t.Name, Description: wireString(t.Description)}) }
		io.Stdout.Println(json.Encode(json.Codec[[]WireTeam]{MaxBytes: 0, MaxDepth: 0}, encodedTeams))
		return
	}
	if len(teams) == 0 {
		io.Stdout.Println("No teams found.")
		return
	}
	io.Stdout.Println("\nTeams:\n")
	for t in teams {
		let d = match t.Description {
		case None:
			""
		case Some[string] as p:
			" - " + p.Value
		}
		io.Stdout.Println("  " + strings.PadRight(t.Key, 8, ' ') + " " + t.Name + d)
	}
	io.Stdout.Println("")
}

func projects(asJson bool) fails linear.ApiError | linear.AuthError | credential.NoToken | credential.ConfigError needs linear.Tracker | io.Stdout {
	let projects = try linear.Tracker.Projects()
	if asJson {
		io.Stdout.Println(json.Encode(json.Codec[[]linear.Project]{MaxBytes: 0, MaxDepth: 0}, projects))
		return
	}
	if len(projects) == 0 {
		io.Stdout.Println("No projects found.")
		return
	}
	io.Stdout.Println("\nProjects:\n")
	for p in projects { io.Stdout.Println("  " + p.Name + "  " + p.State + "  " + p.Id) }
	io.Stdout.Println("")
}

func viewer(asJson bool) fails linear.ApiError | linear.AuthError | credential.NoToken | credential.ConfigError needs linear.Tracker | io.Stdout {
	let v = try linear.Tracker.Viewer()
	if asJson {
		io.Stdout.Println(json.Encode(json.Codec[WireViewer]{MaxBytes: 0, MaxDepth: 0}, wireViewer(v)))
		return
	}
	io.Stdout.Println("\nLogged in as:")
	io.Stdout.Println("  Name:  " + v.Name)
	io.Stdout.Println("  Email: " + v.Email)
	let admin = if v.Admin { "Yes" } else { "No" }
	io.Stdout.Println("  Admin: " + admin)
	match v.Status {
	case Some[linear.Status] as s:
		match s.Value.Label {
		case Some[string] as label:
			let emoji = match s.Value.Emoji {
			case None:
				""
			case Some[string] as e:
				e.Value
			}
			io.Stdout.Println("  Status: " + emoji + " " + label.Value)
		case None:
		}
	case None:
	}
}
