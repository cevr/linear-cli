import flag
import fs
import io
import json
import linearport/credential
import linearport/graphql
import linearport/linear
import os
import strings
import go path/filepath

let queryFlag = flag.String("query", "", "GraphQL document").Repeated()
let queryFileFlag = flag.String("query-file", "", "Workspace query file").Repeated()
let variablesFlag = flag.String("variables", "{}", "Variables JSON object").Repeated()
let allowMutationFlag = flag.Bool("allow-mutation", false, "Explicitly authorize mutations").Repeated()

func realPath(path string) string fails go.Error needs go.Foreign { try filepath.EvalSymlinks(try filepath.Abs(path)) }

// Keep the original platform failure's operation and requested absolute path,
// not Go's failing intermediate symlink component or syscall spelling.
func fileFailure(path string, operation string, target string, kind string) linear.InvalidInput {
	linear.InvalidInput{Message: "Could not read GraphQL query file " + path + ": PlatformError: " + kind + ": FileSystem." + operation + " (" + target + ")"}
}
func platformKind(reason string) string {
	if strings.Contains(reason, "no such file or directory") { return "NotFound" }
	if strings.Contains(reason, "permission denied") { return "PermissionDenied" }
	if strings.Contains(reason, "not a directory") || strings.Contains(reason, "is a directory") || strings.Contains(reason, "too many links") { return "BadResource" }
	"Unknown"
}

func workspaceQuery(path string) string fails linear.InvalidInput needs fs.Files | go.Foreign {
	let workspace = realPath(".") catch {
	case go.Error as e:
		return fileFailure(path, "realPath", ".", platformKind(e.Text))
	}
	let absolute = filepath.Abs(path) catch {
	case go.Error as e:
		return fileFailure(path, "realPath", path, platformKind(e.Text))
	}
	let target = realPath(absolute) catch {
	case go.Error as e:
		return fileFailure(path, "realPath", absolute, platformKind(e.Text))
	}
	let relative = filepath.Rel(workspace, target) catch {
	case _:
		return linear.InvalidInput{Message: "--query-file must stay within the current workspace: " + path}
	}
	if relative == ".." || strings.HasPrefix(relative, "../") || filepath.IsAbs(relative) { return linear.InvalidInput{Message: "--query-file must stay within the current workspace: " + path} }
	let text = fs.Files.ReadFile(target) catch {
	case fs.NotFound:
		return fileFailure(path, "readFile", target, "NotFound")
	case fs.Denied:
		return fileFailure(path, "readFile", target, "PermissionDenied")
	case fs.Failed as e:
		return fileFailure(path, "readFile", target, platformKind(e.Reason))
	}
	if linear.TextUnits(text) > 1000000 { return linear.InvalidInput{Message: "GraphQL query files cannot exceed 1000000 characters"} }
	text
}

func apiGraphQL(v flag.Values) fails os.Exit | linear.InvalidInput | linear.ApiError | linear.AuthError | credential.NoToken | credential.ConfigError needs linear.RawGraphQL | io.Stdout | fs.Files | go.Foreign {
	if present(queryFlag, v) && present(queryFileFlag, v) { return linear.InvalidInput{Message: "Use exactly one of --query or --query-file"} }
	if !present(queryFlag, v) && !present(queryFileFlag, v) { return linear.InvalidInput{Message: "--query or --query-file is required"} }
	let documentText = if present(queryFlag, v) { text(queryFlag, v, "") } else { try workspaceQuery(text(queryFileFlag, v, "")) }
	if linear.TextUnits(documentText) > 1000000 { return linear.InvalidInput{Message: "GraphQL documents cannot exceed 1000000 characters"} }
	let variablesText = text(variablesFlag, v, "{}")
	if linear.TextUnits(variablesText) > 1000000 { return linear.InvalidInput{Message: "--variables cannot exceed 1000000 characters"} }
	let document = graphql.Parse(documentText) catch {
	case graphql.InvalidDocument as e:
		return linear.InvalidInput{Message: "Invalid GraphQL document: " + e.Message}
	}
	if graphql.IsMutation(document) && !enabled(allowMutationFlag, v) { return linear.InvalidInput{Message: "Raw GraphQL mutations require explicit authorization with --allow-mutation. Preview and inspect the document before retrying."} }
	let variables = json.Decode(json.Codec[json.Value]{MaxBytes: 4000000, MaxDepth: 128}, variablesText) catch {
	case _:
		return linear.InvalidInput{Message: "--variables must be a JSON object: SchemaError(Expected a valid JSON string)"}
	}
	match variables {
	case json.Object:
	case _:
		return linear.InvalidInput{Message: "--variables must be a JSON object: SchemaError(Expected object)"}
	}
	let data = try linear.RawGraphQL.Execute(graphql.Text(document), variables)
	io.Stdout.Println(json.Encode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, data))
}
