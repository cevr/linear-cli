import http
import json
import linearport/credential
import linearport/linear

type Client { net http.Net, credentials credential.Credentials }

func New(net http.Net, credentials credential.Credentials) Client {
	Client{net: net, credentials: credentials}
}

type Ask { Query string }
type Error { Message string }
type Envelope { Data json.Optional[json.Value], Errors json.Optional[[]Error] }

func query(c Client, document string) json.Value fails linear.ApiError | linear.AuthError | credential.NoToken | credential.ConfigError {
	let token = try c.credentials.Load()
	let request = credential.Authorize(token, http.Request{Method: "POST", Path: "/graphql", Query: []http.Field{},
		Header: []http.Field{http.Field{Name: "Content-Type", Value: "application/json"}},
		Body:   http.Buffered{Text: json.Encode(json.Codec[Ask]{MaxBytes: 0, MaxDepth: 0}, Ask{Query: document})}})
	let response = c.net.Send(request) catch {
	case http.RequestFailed:
		return linear.ApiError{Message: "request failed"}
	}
	if response.Status == 401 { return linear.AuthError{Message: "Invalid API token"} }
	let envelope = json.Decode(json.Codec[Envelope]{MaxBytes: 8000000, MaxDepth: 64}, response.Body) catch {
	case _:
		return linear.ApiError{Message: "unexpected response"}
	}
	match envelope.Errors {
	case json.Present[[]Error] as errors:
		if len(errors.Value) > 0 { return linear.ApiError{Message: "Error: " + errors.Value[0].Message} }
	case json.Absent:
	}
	match envelope.Data {
	case json.Present[json.Value] as d:
		d.Value
	case json.Absent:
		linear.ApiError{Message: "response has no data"}
	}
}

type PageInfo { HasNextPage bool, EndCursor json.Nullable[string] }
type TeamNode { Id string, Key string, Name string, Description json.Nullable[string] }
type TeamsConnection { Nodes []TeamNode, PageInfo PageInfo }
type TeamsData { Teams TeamsConnection }

func optional[T](s json.Nullable[T]) Option[T] {
	match s {
	case json.Null:
		None
	case json.NonNull[T] as n:
		Some[T]{Value: n.Value}
	}
}

func after(p PageInfo) string fails linear.ApiError {
	match p.EndCursor {
	case json.Null:
		linear.ApiError{Message: "paginated response has no cursor"}
	case json.NonNull[string] as c:
		", after:" + json.Encode(json.Codec[string]{MaxBytes: 0, MaxDepth: 0}, c.Value)
	}
}

func Teams(c Client) []linear.Team fails linear.ApiError | linear.AuthError | credential.NoToken | credential.ConfigError {
	let mut cursor = ""
	let mut result = []linear.Team{}
	for {
		let value = try c.query("query { teams(first: 50" + cursor + ") { nodes { id key name description } pageInfo { hasNextPage endCursor } } }")
		let data = json.Decode(json.Codec[TeamsData]{MaxBytes: 8000000, MaxDepth: 32}, json.Encode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, value)) catch {
		case _:
			return linear.ApiError{Message: "unexpected teams response"}
		}
		for n in data.Teams.Nodes {
			if n.Id == "" || n.Key == "" { return linear.ApiError{Message: "unexpected team identity"} }
			result = result.Append(linear.Team{Id: n.Id, Key: n.Key, Name: n.Name, Description: optional(n.Description)})
		}
		if !data.Teams.PageInfo.HasNextPage { return result }
		let next = try after(data.Teams.PageInfo)
		if next == cursor { return linear.ApiError{Message: "pagination did not advance"} }
		cursor = next
	}
}

type ProjectNode { Id string, Name string, SlugId string, State string, Url string }
type ProjectsConnection { Nodes []ProjectNode, PageInfo PageInfo }
type ProjectsData { Projects ProjectsConnection }

func Projects(c Client) []linear.Project fails linear.ApiError | linear.AuthError | credential.NoToken | credential.ConfigError {
	let mut cursor = ""
	let mut result = []linear.Project{}
	for {
		let value = try c.query("query { projects(first: 50" + cursor + ") { nodes { id name slugId state url } pageInfo { hasNextPage endCursor } } }")
		let data = json.Decode(json.Codec[ProjectsData]{MaxBytes: 8000000, MaxDepth: 32}, json.Encode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, value)) catch {
		case _:
			return linear.ApiError{Message: "unexpected projects response"}
		}
		for n in data.Projects.Nodes { result = result.Append(linear.Project{Id: n.Id, Name: n.Name, Slug: n.SlugId, State: n.State, Url: n.Url}) }
		if !data.Projects.PageInfo.HasNextPage { return result }
		let next = try after(data.Projects.PageInfo)
		if next == cursor { return linear.ApiError{Message: "pagination did not advance"} }
		cursor = next
	}
}

type ViewerNode { Id string, Name string, Email string, Admin bool, StatusEmoji json.Nullable[string], StatusLabel json.Nullable[string] }
type ViewerData { Viewer ViewerNode }

func Viewer(c Client) linear.Viewer fails linear.ApiError | linear.AuthError | credential.NoToken | credential.ConfigError {
	let value = try c.query("query { viewer { id name email admin statusEmoji statusLabel } }")
	let data = json.Decode(json.Codec[ViewerData]{MaxBytes: 8000000, MaxDepth: 32}, json.Encode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, value)) catch {
	case _:
		return linear.ApiError{Message: "unexpected viewer response"}
	}
	let v = data.Viewer
	let emoji = optional(v.StatusEmoji)
	let label = optional(v.StatusLabel)
	let status Option[linear.Status] = match (emoji, label) {
	case (None, None):
		None
	case (_, _):
		Some[linear.Status]{Value: linear.Status{Emoji: emoji, Label: label}}
	}
	linear.Viewer{Id: v.Id, Name: v.Name, Email: v.Email, Admin: v.Admin, Status: status}
}
