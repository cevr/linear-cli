import filepath
import fs
import http
import strings

type NoToken {}
type ConfigError { Message string }

// Token has construction authority in this package; other packages never read
// its contents. Redaction is not claimed to be a language guarantee yet.
type Token { value string }

type Credentials {
	Load() Token fails NoToken | ConfigError,
	// Save keeps the token for later runs. Only the owner can read it.
	Save(t Token) fails ConfigError,
	law NonemptyToken() {
		let token = Load() catch {
		case NoToken, ConfigError:
			return true
		}
		Valid(token)
	},
	// SavedIsLoaded: a saved token is the token the next Load gives, whatever
	// the environment holds (the file comes first).
	law SavedIsLoaded(secret string) {
		let token = FromSecret(secret) catch {
		case NoToken:
			return true
		}
		Save(token) catch {
		case ConfigError:
			return true
		}
		let loaded = Load() catch {
		case NoToken, ConfigError:
			return false
		}
		loaded == token
	},
}

func Valid(t Token) bool { t.value != "" }

// FromSecret is the token a person typed, without surrounding white space.
func FromSecret(secret string) Token fails NoToken {
	let value = strings.TrimSpace(secret)
	if value == "" { return NoToken }
	Token{value: value}
}

func Authorize(t Token, r http.Request) http.Request {
	http.Request{Method: r.Method, Path: r.Path, Query: r.Query,
		Header: r.Header.Append(http.Field{Name: "Authorization", Value: t.value}), Body: r.Body}
}

// Bind makes the token a credential of origin. The transport adds it at that
// origin only, at every hop, so a redirect target never receives it.
func Bind(t Token, origin string) http.Credential fails http.InvalidClient {
	try http.ForOrigin(origin, http.Field{Name: "Authorization", Value: t.value})
}

type File { files fs.Files, writes fs.Writes, home string, env Option[string] }

func New(files fs.Files, writes fs.Writes, home string, env Option[string]) File {
	File{files: files, writes: writes, home: home, env: env}
}

func folder(f File) string { filepath.Join([]string{f.home, ".config", "linear"}) }

func Load(f File) Token fails NoToken | ConfigError {
	let path = filepath.Join([]string{folder(f), "token"})
	let text = f.files.ReadFile(path) catch {
	case fs.NotFound:
		""
	case fs.Denied:
		return ConfigError{Message: "Failed to read token file: permission denied"}
	case fs.Failed as e:
		return ConfigError{Message: "Failed to read token file: " + e.Reason}
	}
	let value = strings.TrimSpace(text)
	if value != "" { return Token{value: value} }
	match f.env {
	case Some[string] as e:
		if e.Value != "" { return Token{value: e.Value} }
	case None:
	}
	NoToken
}

// Save writes the token file with owner-only access (0600).
func Save(f File, t Token) fails ConfigError {
	f.writes.MkdirAll(folder(f)) catch {
	case fs.Denied:
		return ConfigError{Message: "Failed to create config directory: permission denied"}
	case fs.Failed as e:
		return ConfigError{Message: "Failed to create config directory: " + e.Reason}
	}
	f.writes.WriteFileMode(filepath.Join([]string{folder(f), "token"}), t.value, fs.Private()) catch {
	case fs.NotFound:
		return ConfigError{Message: "Failed to save token: no such directory"}
	case fs.Denied:
		return ConfigError{Message: "Failed to save token: permission denied"}
	case fs.Failed as e:
		return ConfigError{Message: "Failed to save token: " + e.Reason}
	}
}
