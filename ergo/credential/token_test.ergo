import fstest

// The generator builds only an in-memory file provider, never Ambient.
// Fixed process cases separately cover file-before-environment precedence.
// One memory serves reads and writes, so SavedIsLoaded reads what Save wrote.
func NewFile(home string, env Option[string]) File {
	let disk = fstest.NewMemory()
	File{files: disk, writes: disk, home: home, env: env}
}

// Mutant token-file-not-private: Save writes the token with fs.Shared() (0644).
// No law reads a file mode; only this test does.
test SavedTokenIsOwnerOnly {
	let disk = fstest.NewMemory()
	let file = New(disk, disk, "h", None)
	try Save(file, try FromSecret("  lin_api_k \n"))
	assert (try disk.Stat("h/.config/linear/token")).Perm == 384
	assert try disk.ReadFile("h/.config/linear/token") == "lin_api_k"
}
